# Bloombly API: environment configuration
# Copy to `.env` and fill in real values. Never commit the filled-in .env.

# --- Google Earth Engine (required for live bloom prediction) ---
# 1. Create a service account in Google Cloud and enable the Earth Engine API.
# 2. Register the service account for Earth Engine access.
# 3. Paste the FULL service-account JSON on a single line below.
EE_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"..."}

# --- Server ---
PORT=5001
DEBUG=False
